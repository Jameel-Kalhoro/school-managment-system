# ─── Database ───────────────────────────────────────────────
# Used by Prisma (packages/database), api and worker
DATABASE_URL="postgresql://sms:sms@localhost:5432/sms?schema=public"

# ─── API ────────────────────────────────────────────────────
API_PORT=4000
API_GLOBAL_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# ─── Auth / JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL=900          # 15 minutes (seconds)
JWT_REFRESH_TTL=1209600     # 14 days (seconds)

# ─── Redis (queues / cron) ──────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Storage (MinIO / S3) ───────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=sms-files
S3_REGION=us-east-1

# ─── Mail (dev → Mailhog) ───────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="School System <no-reply@sms.local>"

# ─── Web (Next.js) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ─── Seed (super admin bootstrap) ───────────────────────────
SUPER_ADMIN_EMAIL=jameelahmedkalhoro@gmail.com
SUPER_ADMIN_PASSWORD=Jameel@12345
SUPER_ADMIN_NAME="Platform Owner"
