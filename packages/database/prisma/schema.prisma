// Prisma schema — single source of truth for the SMS data model.
// Phase 0 covers platform/tenancy + auth. Academic and billing tables
// are layered in during later phases (see PLAN.md §4 & §10).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (mirror @sms/shared) ──────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolStatus {
  ACTIVE
  GRACE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
}

// ─── Tenancy / platform ──────────────────────────────────────

model School {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  address   String?
  city      String?
  phone     String?
  logoUrl   String?
  status    SchoolStatus @default(ACTIVE)

  users        User[]
  subscription Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model User {
  id           String     @id @default(cuid())
  // null for platform-level users (SUPER_ADMIN)
  schoolId     String?
  school       School?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role         Role
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)

  // hashed refresh token for rotation (null when logged out)
  hashedRefreshToken String?
  lastLoginAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([role])
}

// ─── Subscription / plans (billing engine wired up in Phase 3) ─

model SubscriptionPlan {
  id            String        @id @default(cuid())
  name          String
  pricePkr      Int
  billingPeriod BillingPeriod @default(MONTHLY)
  maxStudents   Int?
  maxTeachers   Int?
  features      Json?
  isActive      Boolean       @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id       String             @id @default(cuid())
  schoolId String             @unique
  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId   String
  plan     SubscriptionPlan   @relation(fields: [planId], references: [id])
  status   SubscriptionStatus @default(TRIALING)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceUntil         DateTime?
  cancelAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
