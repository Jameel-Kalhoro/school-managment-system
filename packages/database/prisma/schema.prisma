// Prisma schema — single source of truth for the SMS data model.
// Phase 0 covers platform/tenancy + auth. Academic and billing tables
// are layered in during later phases (see PLAN.md §4 & §10).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (mirror @sms/shared) ──────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum SchoolStatus {
  ACTIVE
  GRACE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum ExamType {
  QUIZ
  MIDTERM
  FINAL
  ASSIGNMENT
}

// ─── Tenancy / platform ──────────────────────────────────────

model School {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  address   String?
  city      String?
  phone     String?
  logoUrl   String?
  status    SchoolStatus @default(ACTIVE)

  users         User[]
  subscription  Subscription?
  academicYears AcademicYear[]
  subjects      Subject[]
  classes       SchoolClass[]
  teachers      Teacher[]
  students      Student[]
  classSubjects ClassSubject[]
  attendance    Attendance[]
  assignments   Assignment[]
  grades        Grade[]
  parentStudents ParentStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String // e.g. "2025-2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  classes SchoolClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model User {
  id           String     @id @default(cuid())
  // null for platform-level users (SUPER_ADMIN)
  schoolId     String?
  school       School?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  role         Role
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)

  // set for provisioned accounts issued a temp password; cleared on change
  mustChangePassword Boolean @default(false)

  // hashed refresh token for rotation (null when logged out)
  hashedRefreshToken String?
  lastLoginAt        DateTime?

  // optional academic-profile link (a login can back a teacher)
  teacher Teacher?
  // students this user (role PARENT) is a guardian of
  parentOf ParentStudent[] @relation("ParentLinks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([role])
}

// ─── Subscription / plans (billing engine wired up in Phase 3) ─

model SubscriptionPlan {
  id            String        @id @default(cuid())
  name          String
  pricePkr      Int
  billingPeriod BillingPeriod @default(MONTHLY)
  maxStudents   Int?
  maxTeachers   Int?
  features      Json?
  isActive      Boolean       @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id       String             @id @default(cuid())
  schoolId String             @unique
  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId   String
  plan     SubscriptionPlan   @relation(fields: [planId], references: [id])
  status   SubscriptionStatus @default(TRIALING)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceUntil         DateTime?
  cancelAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Academics — structure (Phase 2a) ────────────────────────

model Subject {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  code     String?

  classSubjects ClassSubject[]
  assignments   Assignment[]
  grades        Grade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId])
}

model Teacher {
  id            String        @id @default(cuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // the login account backing this teacher (role TEACHER)
  userId        String        @unique
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualification String?
  phone         String?
  joinedAt      DateTime?
  status        TeacherStatus @default(ACTIVE)

  classTeacherOf SchoolClass[]  @relation("ClassTeacher")
  classSubjects  ClassSubject[]
  markedAttendance Attendance[]
  assignments      Assignment[]
  recordedGrades   Grade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
}

model SchoolClass {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  name           String // e.g. "Grade 5"
  section        String? // e.g. "A"
  classTeacherId String?
  classTeacher   Teacher? @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)

  students      Student[]
  classSubjects ClassSubject[]
  attendance    Attendance[]
  assignments   Assignment[]
  grades        Grade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, academicYearId, name, section])
  @@index([schoolId])
  @@index([academicYearId])
}

model Student {
  id            String        @id @default(cuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rollNo        String
  name          String
  gender        Gender?
  dob           DateTime?
  guardianName  String?
  guardianPhone String?
  classId       String?
  class         SchoolClass?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  admissionDate DateTime?
  status        StudentStatus @default(ACTIVE)

  attendance Attendance[]
  grades     Grade[]
  parentLinks ParentStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, rollNo])
  @@index([schoolId])
  @@index([classId])
}

// Which teacher teaches which subject in which class.
model ClassSubject {
  id        String      @id @default(cuid())
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@index([classId])
}

// ─── Academics — activities (Phase 2b) ───────────────────────

// One row per student per class per date.
model Attendance {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId    String
  class      SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  // the teacher who marked it; kept as history even if the teacher is removed
  markedById String?
  markedBy   Teacher?         @relation(fields: [markedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, studentId, date])
  @@index([schoolId])
  @@index([classId, date])
  @@index([studentId])
  @@map("attendance")
}

model Assignment {
  id            String      @id @default(cuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId       String
  class         SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  // the authoring teacher; nulled if the teacher is removed
  teacherId     String?
  teacher       Teacher?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  dueDate       DateTime?
  // plain URL for now — file upload arrives with the files module
  attachmentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId])
  @@index([subjectId])
  @@map("assignments")
}

model Grade {
  id            String      @id @default(cuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId       String
  class         SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examType      ExamType
  marksObtained Float
  totalMarks    Float
  remarks       String?
  // the recording teacher; nulled if the teacher is removed
  recordedById  String?
  recordedBy    Teacher?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@index([classId, subjectId])
  @@index([studentId])
  @@map("grades")
}

// ─── Parent portal (Phase 5) ─────────────────────────────────

// Links a PARENT user to a student they are a guardian of. One parent can be
// linked to many students (siblings); a student can have multiple guardians.
model ParentStudent {
  id        String  @id @default(cuid())
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentId  String
  parent    User    @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([schoolId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_students")
}
